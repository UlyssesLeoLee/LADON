import { ScrollView, ListView } from "std-widgets.slint";
import { Palette } from "theme.slint";
import { Btn, Pill, NavList, MenuRow, ChatLine } from "widgets.slint";

export struct FileItem {
    name: string,
    relative-path: string,
    is-folder: bool,
    is-link: bool,
    tracked: bool,
    can-record: bool,
    size-text: string,
    modified-text: string,
    status-text: string,
}

export struct VersionItem {
    label: string,
    time-text: string,
    actor: string,
    reason: string,
    size-text: string,
    sections-text: string,
    hash-short: string,
    availability-text: string,
    sensitive: bool,
    local: bool,
    current: bool,
    can-compare: bool,
}

export struct DiffItem {
    kind: int,
    old-no: string,
    new-no: string,
    text: string,
}

export struct DriveItem {
    path: string,
    label: string,
    status-text: string,
}

// One checklist row in the document-task view.
component TaskRow inherits Rectangle {
    in property <string> label;
    in property <string> status;
    in property <bool> done: false;

    height: 36px;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 8px;
        Rectangle {
            width: 14px;
            height: 14px;
            y: 11px;
            border-radius: 3px;
            border-width: 1px;
            border-color: root.done ? Palette.accent : Palette.line;
            background: root.done ? Palette.accent : Palette.surface;
        }
        Text {
            text: root.label;
            font-size: 13px;
            color: root.done ? Palette.muted : Palette.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Pill {
            label: root.status;
            tint: root.done ? Palette.sensitive : Palette.state-text;
            fill: root.done ? Palette.sensitive-bg : Palette.chip;
        }
    }
}

// Summary card for one storage location.
component StoreCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> caption;

    horizontal-stretch: 1;
    background: Palette.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Palette.line;
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        Text { text: root.title; font-size: 12px; color: Palette.header-text; }
        Text { text: root.value; font-size: 22px; font-weight: 600; color: Palette.text; }
        Text { text: root.caption; font-size: 12px; color: Palette.muted; wrap: word-wrap; }
    }
}

// One row in the archive queue.
component ArchiveRow inherits Rectangle {
    in property <string> file;
    in property <string> version;
    in property <string> status;

    height: 38px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Text {
            text: root.file;
            font-size: 13px;
            color: Palette.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 2;
        }
        Text {
            text: root.version;
            font-size: 12px;
            color: Palette.muted;
            vertical-alignment: center;
            width: 80px;
        }
        Pill { label: root.status; }
    }
}

// Agent lane card in the parallel workspace.
component AgentCard inherits Rectangle {
    in property <string> letter;
    in property <string> name;
    in property <string> detail;
    in property <string> state-text;
    in property <float> filled: 50;

    horizontal-stretch: 1;
    background: Palette.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Palette.line;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: Palette.accent;
                Text {
                    x: 0px;
                    width: 26px;
                    height: 26px;
                    text: root.letter;
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.name;
                font-size: 13px;
                font-weight: 600;
                color: Palette.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Pill { label: root.state-text; }
        }
        Text { text: root.detail; font-size: 12px; color: Palette.muted; wrap: word-wrap; }
        HorizontalLayout {
            height: 6px;
            Rectangle { horizontal-stretch: root.filled; background: Palette.accent; border-radius: 3px; }
            Rectangle { horizontal-stretch: 100 - root.filled; background: Palette.line; border-radius: 3px; }
        }
    }
}

// Minimise, maximise and close buttons drawn in the custom title bar.
component CaptionButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> danger: false;
    callback clicked();

    width: 42px;
    height: 30px;
    border-radius: 6px;
    background: touch.has-hover ? (root.danger ? Palette.danger : Palette.hover) : transparent;

    Text {
        x: 0px;
        width: root.width;
        height: root.height;
        text: root.glyph;
        font-size: 13px;
        color: (root.danger && touch.has-hover) ? #ffffff : Palette.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: root.width;
        height: root.height;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "LADON";
    icon: @image-url("../../logo/logo/png/LADON_logo_256x256.png");
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 960px;
    min-height: 640px;
    default-font-family: "Microsoft YaHei UI";
    background: Palette.bg;
    no-frame: true;
    forward-focus: path-field;

    in-out property <string> workspace-path;
    in-out property <string> workspace-root;
    in-out property <bool> workspace-open: false;
    in-out property <bool> busy: false;
    in-out property <bool> worker-stopped: false;
    in-out property <string> status: "";
    in-out property <bool> status-error: false;
    in-out property <int> page: 0;
    in-out property <string> current-dir: "";
    in-out property <[FileItem]> folder-items: [];
    in-out property <bool> truncated: false;
    in-out property <int> selected: -1;
    in-out property <string> selected-name: "";
    in-out property <string> selected-path: "";
    in-out property <string> selected-status: "";
    in-out property <string> selected-size: "";
    in-out property <string> selected-modified: "";
    in-out property <bool> selected-is-folder: false;
    in-out property <bool> selected-tracked: false;
    in-out property <bool> selected-sensitive: false;
    in-out property <bool> selected-can-record: false;
    in-out property <string> details-version: "";
    in-out property <string> history-title: "";
    in-out property <string> chain-text: "";
    in-out property <string> history-note: "";
    in-out property <[VersionItem]> versions: [];
    in-out property <string> diff-title: "";
    in-out property <string> diff-totals: "";
    in-out property <string> diff-note: "";
    in-out property <[DiffItem]> diff-lines: [];
    in-out property <bool> init-overlay: false;
    in-out property <string> init-path: "";
    in-out property <bool> about-visible: false;
    in-out property <bool> history-available: false;
    in-out property <[DriveItem]> drives: [];

    callback open-workspace(string);
    callback request-init(string);
    callback confirm-init(string);
    callback cancel-init();
    callback enter-folder(string);
    callback go-up();
    callback select-row(int);
    callback open-history();
    callback capture-selected();
    callback compare-with-previous(int);
    callback back-to-browse();
    callback open-about();
    callback close-about();
    callback refresh-folder();
    callback open-drive(string);
    callback show-this-pc();

    // View state that only the window itself uses.
    property <int> section: 0;
    property <int> nav-index: 2;
    property <bool> sidebar-collapsed: false;
    property <bool> chat-open: false;
    property <int> chat-tab: 0;
    property <bool> tenant-open: false;
    property <bool> tag-open: false;
    property <bool> api-open: false;
    property <bool> menu-open: false;
    property <bool> classic-open: false;
    property <int> menu-row: -1;
    property <bool> suggest-open: false;
    // Details pane: folded at startup, opened by a selection or the toolbar toggle.
    property <bool> details-open-manual: false;
    property <bool> details-closed-manual: false;
    property <bool> details-shown: !root.details-closed-manual && (root.selected >= 0 || root.details-open-manual);

    function close-overlays() {
        root.menu-open = false;
        root.classic-open = false;
        root.tenant-open = false;
        root.api-open = false;
        root.tag-open = false;
    }

    function show-files() {
        root.page = 0;
        root.section = 0;
        root.nav-index = 2;
    }

    function nav-pick(i: int) {
        root.nav-index = i;
        if (i == 0) {
            root.page = 2;
            root.show-this-pc();
        } else if (i == 1 || i == 2 || i == 3) {
            root.page = 0;
            root.section = 0;
        } else if (i == 4) {
            root.page = 0;
            root.section = 1;
        } else if (i == 5) {
            root.page = 0;
            root.section = 2;
        } else if (i == 6) {
            root.page = 0;
            root.section = 3;
        } else if (i == 7) {
            if (root.history-available) {
                root.page = 1;
            }
        } else if (i == 8) {
            root.page = 0;
            root.section = 4;
        }
        root.close-overlays();
    }

    // Leaving This PC for the browse page must not keep the This PC entry highlighted.
    changed page => {
        if (root.page == 0 && root.nav-index == 0) {
            root.nav-index = 2;
        }
    }

    changed selected => {
        root.details-closed-manual = false;
    }

    changed init-overlay => {
        if (root.init-overlay) {
            init-scope.focus();
        } else {
            path-field.focus();
        }
    }

    changed about-visible => {
        if (root.about-visible) {
            keys.focus();
        } else {
            path-field.focus();
        }
    }

    // Lists the open folder again every two seconds while the browse list is shown.
    Timer {
        interval: 2s;
        running: root.workspace-open && root.page == 0 && root.section == 0;
        triggered => { root.refresh-folder(); }
    }

    keys := FocusScope {
        enabled: true;
        width: root.width;
        height: root.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.init-overlay) {
                    root.cancel-init();
                    return accept;
                }
                if (root.about-visible) {
                    root.close-about();
                    return accept;
                }
                if (root.menu-open || root.classic-open || root.tenant-open || root.api-open || root.tag-open) {
                    root.close-overlays();
                    return accept;
                }
            }
            if (event.modifiers.control && (event.text == "b" || event.text == "B")) {
                root.sidebar-collapsed = !root.sidebar-collapsed;
                return accept;
            }
            reject
        }

        VerticalLayout {
            width: 100%;
            height: 100%;

            // Tab strip: product mark, view tabs, tenant switcher.
            Rectangle {
                height: 44px;
                background: Palette.tab-bar;
                WindowMoveArea { }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    spacing: 6px;
                    Image {
                        source: @image-url("../../logo/logo/png/LADON_logo_256x256.png");
                        width: 20px;
                        height: 20px;
                        image-fit: contain;
                    }
                    Text {
                        text: "LADON";
                        font-size: 13px;
                        font-weight: 600;
                        color: Palette.text;
                        vertical-alignment: center;
                    }
                    Rectangle { width: 14px; }
                    Rectangle {
                        width: 104px;
                        height: 30px;
                        border-radius: 8px;
                        background: (root.section == 0 && root.page == 0) ? Palette.tab-active : transparent;
                        Text {
                            x: 0px;
                            width: 104px;
                            height: 30px;
                            text: "文件浏览";
                            font-size: 12px;
                            color: (root.section == 0 && root.page == 0) ? Palette.tab-active-text : Palette.tab-text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.show-files(); }
                        }
                    }
                    Rectangle {
                        width: 104px;
                        height: 30px;
                        border-radius: 8px;
                        background: (root.section == 1 && root.page == 0) ? Palette.tab-active : transparent;
                        Text {
                            x: 0px;
                            width: 104px;
                            height: 30px;
                            text: "文档任务";
                            font-size: 12px;
                            color: (root.section == 1 && root.page == 0) ? Palette.tab-active-text : Palette.tab-text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.page = 0; root.section = 1; root.nav-index = 4; }
                        }
                    }
                    Text {
                        text: "+";
                        width: 24px;
                        font-size: 14px;
                        color: Palette.tab-text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 176px;
                        height: 30px;
                        border-radius: 15px;
                        border-width: 1px;
                        border-color: Palette.chip-line;
                        background: root.tenant-open ? Palette.hover : Palette.chip;
                        Text {
                            x: 0px;
                            width: 176px;
                            height: 30px;
                            text: "个人";
                            font-size: 12px;
                            color: Palette.pill-text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.tenant-open = !root.tenant-open; }
                        }
                    }
                    Rectangle {
                        width: 46px;
                        height: 30px;
                        border-radius: 6px;
                        background: help-touch.has-hover ? Palette.hover : transparent;
                        Text {
                            x: 0px;
                            width: 46px;
                            height: 30px;
                            text: "帮助";
                            font-size: 12px;
                            color: Palette.tab-text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        help-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.open-about(); }
                        }
                    }
                    Rectangle { width: 8px; }
                    CaptionButton {
                        glyph: "—";
                        clicked => { root.minimized = true; }
                    }
                    CaptionButton {
                        glyph: "□";
                        clicked => { root.maximized = !root.maximized; }
                    }
                    CaptionButton {
                        glyph: "×";
                        danger: true;
                        clicked => { root.close(); }
                    }
                }
            }

            // Location bar: path field, navigation and the search box.
            Rectangle {
                height: 48px;
                background: Palette.bg;
                HorizontalLayout {
                    padding: 9px;
                    spacing: 8px;
                    Btn {
                        small: true;
                        label: "↑";
                        disabled: !(root.workspace-open && root.current-dir != "" && !root.busy && !root.worker-stopped);
                        clicked => { root.go-up(); }
                    }
                    Btn {
                        small: true;
                        label: "打开";
                        disabled: root.busy || root.worker-stopped;
                        clicked => { root.open-workspace(root.workspace-path); }
                    }
                    Btn {
                        small: true;
                        label: "初始化";
                        disabled: root.busy || root.worker-stopped || root.workspace-path == "";
                        clicked => { root.request-init(root.workspace-path); }
                    }
                    Rectangle {
                        horizontal-stretch: 3;
                        border-radius: 8px;
                        border-width: path-field.has-focus ? 2px : 1px;
                        border-color: path-field.has-focus ? Palette.focus-ring : Palette.line;
                        background: Palette.surface;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            path-field := TextInput {
                                horizontal-stretch: 1;
                                text <=> root.workspace-path;
                                font-size: 13px;
                                color: Palette.text;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 2;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Palette.line;
                        background: Palette.surface;
                        Text {
                            x: 12px;
                            height: 100%;
                            text: "搜索文件、标签与内容";
                            font-size: 12px;
                            color: Palette.header-text;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Body: sidebar and the active page.
            HorizontalLayout {
                vertical-stretch: 1;

                Rectangle {
                    width: root.sidebar-collapsed ? 62px : 238px;
                    background: Palette.side;
                    animate width { duration: 160ms; }

                    side-list := NavList {
                        width: 100%;
                        height: 100%;
                        labels: ["此电脑", "快速访问", "文件浏览", "搜索", "文档任务", "FileSpace", "云盘存储", "版本历史", "LADON Ignore"];
                        glyphs: ["此", "快", "文", "搜", "任", "F", "云", "历", "I"];
                        active: root.page == 1 ? 7 : (root.page == 2 ? 0 : root.nav-index);
                        expanded: !root.sidebar-collapsed;
                        history-ok: root.history-available;
                        picked(i) => { root.nav-pick(i); }
                    }
                }

                // This PC: the drive roots. Opening one makes it the workspace.
                if root.page == 2 : VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 16px;
                    spacing: 12px;
                    Text { text: "此电脑"; font-size: 18px; font-weight: 600; color: Palette.text; }
                    Rectangle {
                        vertical-stretch: 1;
                        background: Palette.surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Palette.line;
                        clip: true;

                        ListView {
                            width: 100%;
                            height: 100%;
                            for drive in root.drives : Rectangle {
                                height: 44px;
                                background: drive-ta.has-hover ? Palette.hover : transparent;

                                drive-ta := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.open-drive(drive.path); }
                                }

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 12px;
                                    Text {
                                        text: drive.label;
                                        font-size: 13px;
                                        color: Palette.text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: drive.status-text;
                                        font-size: 12px;
                                        color: Palette.state-text;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Text {
                            visible: root.drives.length == 0;
                            x: 0px;
                            width: 100%;
                            height: 100%;
                            text: "没有可用的驱动器";
                            font-size: 13px;
                            color: Palette.header-text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Browse: toolbar, file list and details.
                if root.page == 0 && root.section == 0 : HorizontalLayout {
                    horizontal-stretch: 1;
                    padding: 12px;
                    spacing: 12px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 8px;

                        Rectangle {
                            height: 36px;
                            HorizontalLayout {
                                padding-top: 4px;
                                spacing: 6px;
                                Btn { small: true; label: "新建"; disabled: true; }
                                Btn { small: true; label: "复制"; disabled: true; }
                                Btn { small: true; label: "分享"; disabled: true; }
                                Btn {
                                    small: true;
                                    label: "文档任务";
                                    clicked => { root.section = 1; root.nav-index = 4; }
                                }
                                Btn {
                                    small: true;
                                    label: "AI 标签";
                                    disabled: root.busy || !root.workspace-open;
                                    clicked => { root.tag-open = true; }
                                }
                                Btn {
                                    small: true;
                                    label: "历史";
                                    disabled: root.selected < 0 || !root.selected-tracked || root.selected-is-folder || root.busy || root.worker-stopped;
                                    clicked => { root.open-history(); }
                                }
                                Btn {
                                    small: true;
                                    label: "Agent API";
                                    clicked => { root.api-open = !root.api-open; }
                                }
                                Btn {
                                    small: true;
                                    label: root.details-shown ? "收起详情" : "详情";
                                    clicked => {
                                        if (root.details-shown) {
                                            root.details-closed-manual = true;
                                            root.details-open-manual = false;
                                        } else {
                                            root.details-open-manual = true;
                                            root.details-closed-manual = false;
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: root.workspace-open ? "已同步" : "未打开工作区";
                                    font-size: 12px;
                                    color: Palette.state-text;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            height: 30px;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 8px;
                                Text { text: "名称"; font-size: 12px; color: Palette.header-text; horizontal-stretch: 1; vertical-alignment: center; }
                                Rectangle { width: 22px; }
                                Text { text: "修改时间"; font-size: 12px; color: Palette.header-text; width: 150px; vertical-alignment: center; }
                                Text { text: "大小"; font-size: 12px; color: Palette.header-text; width: 90px; vertical-alignment: center; }
                                Text { text: "状态"; font-size: 12px; color: Palette.header-text; width: 140px; vertical-alignment: center; }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            background: Palette.surface;
                            border-radius: 10px;
                            clip: true;

                            list-scope := FocusScope {
                                enabled: true;
                                width: 0px;
                                height: 0px;

                                init => { if (root.workspace-open) { list-scope.focus(); } }

                                key-pressed(event) => {
                                    if (event.text == Key.DownArrow) {
                                        if (root.selected < root.folder-items.length - 1) {
                                            root.select-row(root.selected + 1);
                                            folder-list.ensure-row-visible(root.selected, ScrollBehavior.instant);
                                        }
                                        return accept;
                                    }
                                    if (event.text == Key.UpArrow) {
                                        if (root.selected < 0 && root.folder-items.length > 0) {
                                            root.select-row(0);
                                            folder-list.ensure-row-visible(root.selected, ScrollBehavior.instant);
                                        } else if (root.selected > 0) {
                                            root.select-row(root.selected - 1);
                                            folder-list.ensure-row-visible(root.selected, ScrollBehavior.instant);
                                        }
                                        return accept;
                                    }
                                    if (event.text == Key.Return && root.selected >= 0 && root.selected-is-folder) {
                                        root.enter-folder(root.selected-path);
                                        return accept;
                                    }
                                    if (event.text == Key.Return && root.selected >= 0 && root.selected-tracked) {
                                        root.open-history();
                                        return accept;
                                    }
                                    if (event.text == Key.Backspace && root.workspace-open && root.current-dir != "") {
                                        root.go-up();
                                        return accept;
                                    }
                                    reject
                                }
                            }

                            folder-list := ListView {
                                width: 100%;
                                height: 100%;
                                for item[index] in root.folder-items : Rectangle {
                                    height: 40px;
                                    background: root.selected == index ? Palette.nav-active : transparent;

                                    row-ta := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        pointer-event(event) => {
                                            if (event.kind == PointerEventKind.down) {
                                                list-scope.focus();
                                                root.select-row(index);
                                                if (event.button == PointerEventButton.right) {
                                                    root.menu-row = index;
                                                    root.menu-open = true;
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 8px;
                                        Text {
                                            text: item.name;
                                            font-weight: item.is-folder ? 600 : 400;
                                            font-size: 13px;
                                            color: item.is-link && root.selected != index ? Palette.muted : Palette.text;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            visible: row-ta.has-hover;
                                            text: "…";
                                            font-size: 14px;
                                            color: Palette.muted;
                                            width: 22px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: item.modified-text;
                                            font-size: 12px;
                                            color: Palette.muted;
                                            width: 150px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: item.size-text;
                                            font-size: 12px;
                                            color: Palette.muted;
                                            width: 90px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: item.status-text;
                                            font-size: 12px;
                                            color: item.tracked ? Palette.accent : Palette.muted;
                                            width: 140px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }

                            Text {
                                visible: root.folder-items.length == 0;
                                x: 0px;
                                width: 100%;
                                height: 100%;
                                text: root.workspace-open ? "此文件夹为空" : "在上方输入工作区路径，然后点击“打开”。";
                                font-size: 13px;
                                color: Palette.header-text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: 10px;
                                border-width: list-scope.has-focus ? 2px : 1px;
                                border-color: list-scope.has-focus ? Palette.focus-ring : Palette.line;
                            }
                        }
                    }

                    if root.details-shown : Rectangle {
                        width: 280px;
                        background: Palette.surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Palette.line;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "详情"; font-size: 12px; color: Palette.header-text; vertical-alignment: center; horizontal-stretch: 1; }
                                Btn {
                                    small: true;
                                    label: "收起";
                                    clicked => {
                                        root.details-closed-manual = true;
                                        root.details-open-manual = false;
                                    }
                                }
                            }
                            Text {
                                text: root.selected >= 0 ? root.selected-name : "未选择文件";
                                font-size: 16px;
                                font-weight: 600;
                                color: Palette.text;
                                wrap: word-wrap;
                            }
                            Text {
                                visible: root.selected >= 0;
                                text: "状态：" + root.selected-status;
                                font-size: 12px;
                                color: Palette.state-text;
                                wrap: word-wrap;
                            }
                            Text {
                                visible: root.selected >= 0;
                                text: "大小：" + root.selected-size + "    修改：" + root.selected-modified;
                                font-size: 12px;
                                color: Palette.muted;
                                wrap: word-wrap;
                            }
                            Text {
                                visible: root.details-version != "";
                                text: root.details-version;
                                font-size: 12px;
                                color: Palette.text;
                                wrap: word-wrap;
                            }
                            Rectangle {
                                visible: root.selected >= 0 && root.selected-sensitive;
                                background: Palette.sensitive-bg;
                                border-radius: 8px;
                                VerticalLayout {
                                    padding: 10px;
                                    Text {
                                        text: "敏感文件：内容不会上传到外部存储或 AI。";
                                        font-size: 12px;
                                        color: Palette.sensitive;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            Btn {
                                label: "进入文件夹";
                                primary: true;
                                visible: root.selected >= 0 && root.selected-is-folder;
                                disabled: root.busy || root.worker-stopped;
                                clicked => { root.enter-folder(root.selected-path); }
                            }
                            Btn {
                                label: "记录此文件";
                                primary: true;
                                visible: root.selected >= 0 && root.selected-can-record && !root.selected-tracked;
                                disabled: !root.selected-can-record || root.busy || root.worker-stopped;
                                clicked => { root.capture-selected(); }
                            }
                            Btn {
                                label: "记录新版本";
                                primary: true;
                                visible: root.selected >= 0 && root.selected-can-record && root.selected-tracked;
                                disabled: !root.selected-can-record || root.busy || root.worker-stopped;
                                clicked => { root.capture-selected(); }
                            }
                            Btn {
                                label: "查看完整历史";
                                visible: root.selected >= 0 && root.selected-can-record && root.selected-tracked;
                                disabled: root.busy || root.worker-stopped;
                                clicked => { root.open-history(); }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                }

                // Document tasks: the document beside its task list and comments.
                if root.page == 0 && root.section == 1 : HorizontalLayout {
                    horizontal-stretch: 1;
                    padding: 12px;
                    spacing: 12px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 10px;
                        Rectangle {
                            height: 46px;
                            background: Palette.surface;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Palette.line;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 12px;
                                padding-bottom: 12px;
                                spacing: 8px;
                                Text { text: "要件定义.md"; font-size: 15px; font-weight: 600; color: Palette.text; vertical-alignment: center; }
                                Text { text: "产品设计 · 文档即任务"; font-size: 12px; color: Palette.muted; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Pill { label: "已同步"; tint: Palette.sensitive; fill: Palette.sensitive-bg; }
                                Btn { small: true; label: "生成变更计划"; disabled: true; }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            background: Palette.surface;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Palette.line;
                            VerticalLayout {
                                padding: 28px;
                                spacing: 12px;
                                Text { text: "要件定义书"; font-size: 22px; font-weight: 600; color: Palette.text; }
                                Text { text: "REQ-023 自动同步流程"; font-size: 15px; font-weight: 600; color: Palette.accent; }
                                Text {
                                    text: "系统在检测到文件版本变化后生成同步计划，并在本地完成差异比对。所有内容仅在授权工作区内处理，不向外部服务发送敏感资料。";
                                    font-size: 13px;
                                    color: Palette.text;
                                    wrap: word-wrap;
                                }
                                Rectangle {
                                    background: Palette.chip;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Palette.chip-line;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 4px;
                                        Text { text: "批注 · Kate"; font-size: 12px; font-weight: 600; color: Palette.state-text; }
                                        Text { text: "此处需要与 ST-014 对齐，见测试关系图。"; font-size: 13px; color: Palette.text; wrap: word-wrap; }
                                    }
                                }
                                Text { text: "第 2 节 · 版本与差异"; font-size: 14px; font-weight: 600; color: Palette.text; }
                                Text {
                                    text: "每次保存都会形成一个版本。版本之间的差异按行展示，二进制文件不展开比较。";
                                    font-size: 13px;
                                    color: Palette.muted;
                                    wrap: word-wrap;
                                }
                                Rectangle { vertical-stretch: 1; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Pill { label: "基本设计"; }
                                    Pill { label: "ST-014"; }
                                    Pill { label: "architecture.nema"; }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        width: 300px;
                        spacing: 12px;
                        Rectangle {
                            vertical-stretch: 1;
                            background: Palette.surface;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Palette.line;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;
                                Text { text: "文档任务"; font-size: 14px; font-weight: 600; color: Palette.text; }
                                TaskRow { label: "更新 REQ-023 接口说明"; status: "待处理"; }
                                TaskRow { label: "同步 ST-014 测试用例"; status: "进行中"; }
                                TaskRow { label: "确认 architecture.nema 引用"; status: "已完成"; done: true; }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            background: Palette.surface;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Palette.line;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text { text: "批注"; font-size: 14px; font-weight: 600; color: Palette.text; }
                                Rectangle {
                                    background: Palette.chip;
                                    border-radius: 8px;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 4px;
                                        Text { text: "Kate · 15:20"; font-size: 11px; color: Palette.status; }
                                        Text { text: "REQ-023 修改已同步，请检查第 3 节。"; font-size: 12px; color: Palette.text; wrap: word-wrap; }
                                    }
                                }
                                Rectangle {
                                    background: Palette.chip;
                                    border-radius: 8px;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 4px;
                                        Text { text: "Mike · 15:32"; font-size: 11px; color: Palette.status; }
                                        Text { text: "已审阅，等待 ST-014 更新。"; font-size: 12px; color: Palette.text; wrap: word-wrap; }
                                    }
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                }

                // FileSpace: parallel agent lanes and the commit review queue.
                if root.page == 0 && root.section == 2 : VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 16px;
                    spacing: 12px;
                    Text { text: "FileSpace · 并行工作区"; font-size: 18px; font-weight: 600; color: Palette.text; }
                    Text {
                        text: "TaskSpace 模式 · Snapshot 隔离 · Commit Coordinator 统一合并";
                        font-size: 12px;
                        color: Palette.muted;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        AgentCard { letter: "A"; name: "要件分析"; detail: "REQ-027 · 读取 3 个文件"; state-text: "运行中"; filled: 60; }
                        AgentCard { letter: "B"; name: "测试设计更新"; detail: "ST-014 · 等待依赖"; state-text: "等待"; filled: 35; }
                        AgentCard { letter: "C"; name: "AI 批量索引"; detail: "仅本地 · 已完成 80%"; state-text: "完成"; filled: 80; }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: Palette.surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Palette.line;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 6px;
                            Text { text: "Agent 操作计划 · 提交审查"; font-size: 14px; font-weight: 600; color: Palette.text; }
                            ArchiveRow { file: "调用 REQ-023 更新说明"; version: "A-01"; status: "待审查"; }
                            ArchiveRow { file: "更新 ST-014 测试用例"; version: "B-02"; status: "等待"; }
                            ArchiveRow { file: "标记 STG-014 过期"; version: "C-03"; status: "已通过"; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                }

                // Storage centre: local, Google Drive and NAS locations.
                if root.page == 0 && root.section == 3 : VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 16px;
                    spacing: 12px;
                    Text { text: "存储中心"; font-size: 18px; font-weight: 600; color: Palette.text; }
                    Text {
                        text: "本地工作区与云盘、NAS 的归档状态。云盘与 NAS 的归档功能将在下一版接入。";
                        font-size: 12px;
                        color: Palette.muted;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        StoreCard { title: "本地数据"; value: "2.4 GB"; caption: "工作区 · 数据库与版本仓库"; }
                        StoreCard { title: "Google Drive"; value: "128.4 GB"; caption: "已连接 · 归档与分享"; }
                        StoreCard { title: "NAS"; value: "—"; caption: "未连接 · 需要先添加设备"; }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: Palette.surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Palette.line;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 6px;
                            Text { text: "历史归档队列"; font-size: 14px; font-weight: 600; color: Palette.text; }
                            ArchiveRow { file: "要件定义.md"; version: "v12"; status: "已归档"; }
                            ArchiveRow { file: "基本设计.md"; version: "v10"; status: "排队中"; }
                            ArchiveRow { file: "ST-014.xlsx"; version: "v05"; status: "待上传"; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                }

                // LADON Ignore: rule file and the rule tester.
                if root.page == 0 && root.section == 4 : HorizontalLayout {
                    horizontal-stretch: 1;
                    padding: 16px;
                    spacing: 12px;
                    Rectangle {
                        horizontal-stretch: 3;
                        background: Palette.surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Palette.line;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 6px;
                            Text { text: ".LADONignore · 敏感资源保护"; font-size: 15px; font-weight: 600; color: Palette.text; }
                            Text { text: "列出的路径不会被发送到外部存储或 AI；本地历史仍然保留。"; font-size: 12px; color: Palette.muted; wrap: word-wrap; }
                            Rectangle {
                                vertical-stretch: 1;
                                background: Palette.chip;
                                border-radius: 8px;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 6px;
                                    Text { text: "1   # 敏感资源"; font-family: "Consolas"; font-size: 13px; color: Palette.muted; }
                                    Text { text: "2   *.key"; font-family: "Consolas"; font-size: 13px; color: Palette.text; }
                                    Text { text: "3   *.pem"; font-family: "Consolas"; font-size: 13px; color: Palette.text; }
                                    Text { text: "4   .env"; font-family: "Consolas"; font-size: 13px; color: Palette.text; }
                                    Text { text: "5   secrets/"; font-family: "Consolas"; font-size: 13px; color: Palette.text; }
                                    Text { text: "6   **/*.p12"; font-family: "Consolas"; font-size: 13px; color: Palette.text; }
                                    Text { text: "7   # 个人笔记 · 不向外传输"; font-family: "Consolas"; font-size: 13px; color: Palette.muted; }
                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                        }
                    }
                    Rectangle {
                        width: 300px;
                        background: Palette.surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Palette.line;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Text { text: "规则测试"; font-size: 14px; font-weight: 600; color: Palette.text; }
                            Text { text: "测试路径"; font-size: 12px; color: Palette.muted; }
                            Rectangle {
                                height: 30px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Palette.line;
                                background: Palette.bg;
                                Text { x: 10px; height: 100%; text: "product-brief-client-data.xlsx"; font-size: 12px; color: Palette.text; vertical-alignment: center; }
                            }
                            Rectangle {
                                height: 52px;
                                border-radius: 8px;
                                background: Palette.removed-bg;
                                VerticalLayout {
                                    padding: 10px;
                                    Text { text: "已阻止 · 外部传输"; font-size: 12px; font-weight: 600; color: Palette.removed-text; }
                                }
                            }
                            Text { text: "本地历史：允许"; font-size: 12px; color: Palette.state-text; }
                            Text { text: "AI 嵌入：禁止"; font-size: 12px; color: Palette.state-text; }
                            Rectangle { vertical-stretch: 1; }
                            Btn { label: "查看被阻止文件"; disabled: true; }
                        }
                    }
                }

                // Version history: versions on the left, the diff on the right.
                if root.page == 1 : HorizontalLayout {
                    horizontal-stretch: 1;
                    padding: 12px;
                    spacing: 12px;

                    VerticalLayout {
                        width: 380px;
                        spacing: 10px;
                        HorizontalLayout {
                            height: 30px;
                            spacing: 8px;
                            Btn { small: true; label: "← 返回浏览"; clicked => { root.back-to-browse(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            background: Palette.surface;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Palette.line;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                Text {
                                    text: root.history-title;
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Palette.text;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: root.chain-text;
                                    font-size: 12px;
                                    color: Palette.state-text;
                                    wrap: word-wrap;
                                }
                                Text {
                                    visible: root.history-note != "";
                                    text: root.history-note;
                                    font-size: 12px;
                                    color: Palette.muted;
                                    wrap: word-wrap;
                                }
                                ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        spacing: 8px;
                                        for version[index] in root.versions : Rectangle {
                                            background: Palette.surface;
                                            border-radius: 10px;
                                            border-width: 1px;
                                            border-color: version.current ? Palette.accent : Palette.line;
                                            VerticalLayout {
                                                padding: 12px;
                                                spacing: 4px;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text { text: version.label; font-size: 13px; color: Palette.text; font-weight: 600; vertical-alignment: center; }
                                                    Pill { label: "当前版本"; visible: version.current; tint: Palette.sensitive; fill: Palette.sensitive-bg; }
                                                    Rectangle { horizontal-stretch: 1; }
                                                    Text { text: version.time-text; font-size: 11px; color: Palette.muted; horizontal-alignment: right; vertical-alignment: center; }
                                                }
                                                Text { text: version.actor + " · " + version.reason; font-size: 12px; color: Palette.muted; wrap: word-wrap; }
                                                Text { text: version.size-text + " · " + version.sections-text; font-size: 12px; color: Palette.text; wrap: word-wrap; }
                                                Text { text: version.hash-short; font-size: 11px; color: Palette.muted; font-family: "Consolas"; }
                                                Text { text: version.availability-text; font-size: 12px; color: Palette.muted; wrap: word-wrap; }
                                                HorizontalLayout {
                                                    Btn {
                                                        small: true;
                                                        label: "与上一版比较";
                                                        disabled: !version.can-compare || root.busy || root.worker-stopped;
                                                        clicked => { root.compare-with-previous(index); }
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: Palette.surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Palette.line;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 6px;
                            Text {
                                text: root.diff-title == "" ? "选择“与上一版比较”查看差异。" : root.diff-title;
                                font-size: 14px;
                                font-weight: 600;
                                color: Palette.text;
                                wrap: word-wrap;
                            }
                            Text { text: root.diff-totals; font-size: 12px; color: Palette.muted; }
                            Text {
                                visible: root.diff-note != "";
                                text: root.diff-note;
                                font-size: 12px;
                                color: Palette.danger;
                                wrap: word-wrap;
                            }
                            ListView {
                                vertical-stretch: 1;
                                for line[index] in root.diff-lines : Rectangle {
                                    height: 22px;
                                    background: line.kind == 1 ? Palette.added-bg : (line.kind == 2 ? Palette.removed-bg : transparent);
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        spacing: 10px;
                                        Text {
                                            text: line.old-no;
                                            width: 48px;
                                            font-size: 12px;
                                            color: Palette.muted;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: line.new-no;
                                            width: 48px;
                                            font-size: 12px;
                                            color: Palette.muted;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: line.kind == 1 ? "+ " + line.text : (line.kind == 2 ? "− " + line.text : (line.kind == 3 ? "…" : "  " + line.text));
                                            font-size: 12px;
                                            color: line.kind == 1 ? Palette.added-text : (line.kind == 2 ? Palette.removed-text : (line.kind == 3 ? Palette.muted : Palette.text));
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Bottom dock: AI and team chat, status line, input row.
            Rectangle {
                height: root.chat-open ? 300px : 50px;
                background: Palette.dock;
                animate height { duration: 180ms; }

                VerticalLayout {
                    Rectangle { height: 1px; background: Palette.dock-line; }

                    if root.chat-open : Rectangle {
                        vertical-stretch: 1;
                        background: Palette.dock;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 6px;
                                Btn { small: true; label: "AI 助手"; primary: root.chat-tab == 0; clicked => { root.chat-tab = 0; } }
                                Btn { small: true; label: "团队通信"; primary: root.chat-tab == 1; clicked => { root.chat-tab = 1; } }
                                Rectangle { horizontal-stretch: 1; }
                                Btn { small: true; label: "收起"; clicked => { root.chat-open = false; } }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                background: Palette.surface;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Palette.dock-line;
                                clip: true;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 10px;
                                    if root.chat-tab == 0 : ChatLine {
                                        who: "AI 助手";
                                        at: "16:43";
                                        body: "相关设计任务已经关联到 REQ-027，待审阅。";
                                    }
                                    if root.chat-tab == 0 : ChatLine {
                                        who: "我";
                                        at: "16:41";
                                        body: "列出本周需要审阅的变更。";
                                    }
                                    if root.chat-tab == 1 : ChatLine {
                                        who: "Kate";
                                        at: "15:20";
                                        body: "REQ-023 修改已同步，请检查第 3 节。";
                                    }
                                    if root.chat-tab == 1 : ChatLine {
                                        who: "Mike";
                                        at: "15:32";
                                        body: "已审阅，等待 ST-014 更新。";
                                    }
                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 49px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 8px;
                            Text {
                                text: root.status;
                                color: root.status-error ? Palette.danger : Palette.status;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                visible: root.busy;
                                text: "处理中…";
                                font-size: 12px;
                                color: Palette.state-text;
                                vertical-alignment: center;
                            }
                            Text {
                                visible: root.worker-stopped;
                                text: "后台服务已停止，请关闭并重新打开应用。";
                                font-size: 12px;
                                color: Palette.danger;
                                vertical-alignment: center;
                            }
                            Btn {
                                small: true;
                                label: "建议";
                                visible: root.workspace-open;
                                clicked => { root.suggest-open = !root.suggest-open; }
                            }
                            Btn {
                                small: true;
                                label: "AI 助手";
                                clicked => { root.chat-tab = 0; root.chat-open = !root.chat-open; }
                            }
                            Btn {
                                small: true;
                                label: "团队";
                                clicked => { root.chat-tab = 1; root.chat-open = !root.chat-open; }
                            }
                            Rectangle {
                                horizontal-stretch: 3;
                                height: 28px;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: Palette.dock-line;
                                background: Palette.surface;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: "向 AI 或成员发送消息…";
                                        font-size: 12px;
                                        color: Palette.header-text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                            Btn { small: true; label: "发送"; primary: true; disabled: true; }
                        }
                    }
                }
            }
        }

        // Clicking outside an open menu or popover closes it.
        TouchArea {
            enabled: root.menu-open || root.classic-open || root.tenant-open || root.api-open;
            width: root.width;
            height: root.height;
            clicked => { root.close-overlays(); }
        }

        // Sidebar flyout while the sidebar is collapsed.
        hover-panel := Rectangle {
            visible: root.sidebar-collapsed && (side-list.hovered || hover-list.hovered);
            x: 0px;
            y: 92px;
            width: 238px;
            height: root.height - 92px - 50px;
            background: Palette.side;
            drop-shadow-blur: 16px;
            drop-shadow-color: #1f2a2228;
            drop-shadow-offset-x: 4px;

            hover-list := NavList {
                width: 100%;
                height: 100%;
                labels: ["此电脑", "快速访问", "文件浏览", "搜索", "文档任务", "FileSpace", "云盘存储", "版本历史", "LADON Ignore"];
                glyphs: ["此", "快", "文", "搜", "任", "F", "云", "历", "I"];
                active: root.page == 1 ? 7 : (root.page == 2 ? 0 : root.nav-index);
                expanded: true;
                history-ok: root.history-available;
                picked(i) => { root.nav-pick(i); }
            }
        }

        // Row context menu (right-click on a file).
        ctx-menu := Rectangle {
            visible: root.menu-open && root.page == 0 && root.section == 0;
            x: root.width - 548px;
            y: 190px + (root.menu-row + 1) * 40px;
            width: 236px;
            height: 338px;
            background: Palette.surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.menu-line;
            drop-shadow-blur: 18px;
            drop-shadow-color: #1f2a2230;
            drop-shadow-offset-y: 6px;
            VerticalLayout {
                padding: 6px;
                spacing: 1px;
                MenuRow { label: "打开"; clicked => { root.close-overlays(); } }
                MenuRow { label: "打开方式"; clicked => { root.close-overlays(); } }
                MenuRow { label: "复制"; clicked => { root.close-overlays(); } }
                MenuRow { label: "重命名"; clicked => { root.close-overlays(); } }
                MenuRow { label: "压缩为 ZIP"; clicked => { root.close-overlays(); } }
                MenuRow { label: "删除"; clicked => { root.close-overlays(); } }
                Rectangle { height: 9px; }
                MenuRow {
                    label: "查看完整历史";
                    disabled: root.selected < 0 || !root.selected-tracked || root.selected-is-folder;
                    clicked => { root.open-history(); root.close-overlays(); }
                }
                MenuRow { label: "文档任务"; clicked => { root.section = 1; root.nav-index = 4; root.close-overlays(); } }
                MenuRow { label: "AI 标签"; clicked => { root.tag-open = true; root.menu-open = false; } }
                MenuRow { label: "添加到敏感文件"; clicked => { root.close-overlays(); } }
                Rectangle { height: 9px; }
                MenuRow { label: "Windows 传统菜单"; clicked => { root.menu-open = false; root.classic-open = true; } }
            }
        }

        // Windows classic context menu.
        classic-menu := Rectangle {
            visible: root.classic-open && root.page == 0 && root.section == 0;
            x: root.width - 548px;
            y: 190px + (root.menu-row + 1) * 40px;
            width: 236px;
            height: 252px;
            background: Palette.surface;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.menu-line;
            drop-shadow-blur: 14px;
            drop-shadow-color: #1f2a2228;
            VerticalLayout {
                padding: 4px;
                spacing: 1px;
                MenuRow { label: "打开"; clicked => { root.close-overlays(); } }
                MenuRow { label: "打开方式"; clicked => { root.close-overlays(); } }
                MenuRow { label: "复制"; clicked => { root.close-overlays(); } }
                MenuRow { label: "重命名"; clicked => { root.close-overlays(); } }
                MenuRow { label: "压缩为 ZIP"; clicked => { root.close-overlays(); } }
                MenuRow { label: "删除"; clicked => { root.close-overlays(); } }
                MenuRow { label: "属性"; clicked => { root.close-overlays(); } }
                Rectangle { height: 9px; }
                MenuRow { label: "显示更多选项"; clicked => { root.close-overlays(); } }
            }
        }

        // Tenant and workspace switcher.
        tenant-menu := Rectangle {
            visible: root.tenant-open;
            x: root.width - 292px;
            y: 50px;
            width: 280px;
            height: 236px;
            background: Palette.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.menu-line;
            drop-shadow-blur: 18px;
            drop-shadow-color: #1f2a2230;
            drop-shadow-offset-y: 6px;
            VerticalLayout {
                padding: 10px;
                spacing: 2px;
                Text { text: "切换工作空间"; font-size: 11px; color: Palette.header-text; height: 22px; vertical-alignment: center; }
                MenuRow { label: "个人 · 当前"; clicked => { root.close-overlays(); } }
                MenuRow { label: "Research Team"; clicked => { root.close-overlays(); } }
                Rectangle { height: 9px; }
                MenuRow { label: "成员与角色"; clicked => { root.close-overlays(); } }
                MenuRow { label: "跨空间共享设置"; clicked => { root.close-overlays(); } }
                MenuRow { label: "账号与安全"; clicked => { root.close-overlays(); } }
                Rectangle { vertical-stretch: 1; }
            }
        }

        // Agent folder API flyout over the detail panel.
        api-flyout := Rectangle {
            visible: root.api-open && root.page == 0 && root.section == 0;
            x: root.width - 352px;
            y: 190px;
            width: 340px;
            height: 268px;
            background: Palette.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.menu-line;
            drop-shadow-blur: 18px;
            drop-shadow-color: #1f2a2230;
            drop-shadow-offset-y: 6px;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                Text { text: "Agent 文件夹 API"; font-size: 14px; font-weight: 600; color: Palette.text; }
                Text { text: "仅在授权工作区内生效；每次调用都需要确认。"; font-size: 11px; color: Palette.muted; wrap: word-wrap; }
                HorizontalLayout { spacing: 8px; Text { text: "浏览文件夹"; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; } Pill { label: "只读"; } }
                HorizontalLayout { spacing: 8px; Text { text: "读取版本与差异"; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; } Pill { label: "只读"; } }
                HorizontalLayout { spacing: 8px; Text { text: "批量标签建议"; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; } Pill { label: "需确认"; tint: Palette.state-text; } }
                HorizontalLayout { spacing: 8px; Text { text: "提交变更"; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; } Pill { label: "需确认"; tint: Palette.state-text; } }
                Rectangle { vertical-stretch: 1; }
                Text { text: "HTTP / MCP 访问默认关闭。"; font-size: 11px; color: Palette.status; }
            }
        }

        // Suggestion card (shown after the user opens it from the dock).
        suggest-card := Rectangle {
            visible: root.suggest-open && !root.chat-open && root.page == 0 && root.section == 0;
            x: root.width - 352px;
            y: root.height - 50px - 16px - 150px;
            width: 330px;
            height: 150px;
            background: Palette.toast-bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.toast-line;
            drop-shadow-blur: 14px;
            drop-shadow-color: #1f2a2228;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                Text { text: "发现一个需要审阅的变更"; font-size: 14px; font-weight: 600; color: Palette.toast-text; }
                Text {
                    text: "REQ-027 最近修改了要件，相关的 ST-032 测试尚未更新。";
                    font-size: 12px;
                    color: Palette.toast-text;
                    wrap: word-wrap;
                }
                Text { text: "证据：要件指纹变化 · 测试关系图 · 测试失败事件"; font-size: 11px; color: Palette.state-text; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Btn { small: true; label: "稍后"; clicked => { root.suggest-open = false; } }
                    Btn { small: true; label: "查看建议"; primary: true; clicked => { root.suggest-open = false; } }
                }
            }
        }

        // AI batch tagging dialog.
        tag-scrim := Rectangle {
            visible: root.tag-open;
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            background: Palette.scrim;
            TouchArea { width: 100%; height: 100%; clicked => { root.tag-open = false; } }
            Rectangle {
                x: (root.width - 520px) / 2;
                y: (root.height - 340px) / 2;
                width: 520px;
                height: 340px;
                background: Palette.surface;
                border-radius: 12px;
                TouchArea { width: 100%; height: 100%; }
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text { text: "AI 批量打标签"; font-size: 16px; font-weight: 600; color: Palette.text; }
                    Text { text: "标签建议"; font-size: 12px; color: Palette.muted; }
                    HorizontalLayout {
                        spacing: 8px;
                        Pill { label: "项目归档"; }
                        Pill { label: "设计阶段"; }
                        Pill { label: "需审阅"; tint: Palette.state-text; }
                        Pill { label: "含敏感内容"; tint: Palette.danger; fill: Palette.removed-bg; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text { text: "自定义规则"; font-size: 12px; color: Palette.muted; }
                    Rectangle {
                        height: 70px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Palette.line;
                        background: Palette.bg;
                        Text {
                            x: 10px;
                            y: 8px;
                            width: 96%;
                            text: "根据文件名与正文生成标签，仅在本地分析。";
                            font-size: 12px;
                            color: Palette.text;
                            wrap: word-wrap;
                        }
                    }
                    Text { text: "分析仅在本地进行，不会上传文件内容。"; font-size: 11px; color: Palette.status; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        Btn { label: "取消"; clicked => { root.tag-open = false; } }
                        Btn { label: "开始分析"; primary: true; disabled: true; }
                    }
                }
            }
        }

        // Initialise-workspace confirmation.
        Rectangle {
            visible: root.init-overlay;
            width: root.width;
            height: root.height;
            background: Palette.scrim;
            TouchArea { }
            Rectangle {
                width: 460px;
                height: 236px;
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                background: Palette.surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: Palette.menu-line;
                drop-shadow-blur: 18px;
                drop-shadow-color: #1f2a2230;
                drop-shadow-offset-y: 6px;
                init-scope := FocusScope {
                    enabled: root.init-overlay;
                    width: 0px;
                    height: 0px;
                    key-pressed(event) => {
                        if (event.text == Key.Return && root.init-overlay && !root.busy && !root.worker-stopped && root.init-path != "") {
                            root.confirm-init(root.init-path);
                            return accept;
                        }
                        reject
                    }
                }
                VerticalLayout {
                    padding: 22px;
                    spacing: 14px;
                    Text {
                        text: "初始化工作区";
                        font-size: 16px;
                        font-weight: 600;
                        color: Palette.text;
                    }
                    Text {
                        text: root.init-path == "" ? "请先在上方输入要初始化的文件夹路径。" : "将以下文件夹初始化为工作区：" + root.init-path + "。这会在其中创建 .ladon 目录和 .LADONignore 规则文件。之后可以记录该文件夹中文件的历史。不会上传任何文件。";
                        font-size: 13px;
                        color: Palette.muted;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        Btn {
                            label: "取消";
                            clicked => { root.cancel-init(); }
                        }
                        Btn {
                            label: "确认初始化";
                            primary: true;
                            disabled: root.busy || root.worker-stopped || root.init-path == "";
                            clicked => { root.confirm-init(root.init-path); }
                        }
                    }
                }
            }
        }

        // About dialog.
        Rectangle {
            visible: root.about-visible;
            width: root.width;
            height: root.height;
            background: Palette.scrim;
            TouchArea { }
            Rectangle {
                width: 420px;
                height: 230px;
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                background: Palette.surface;
                border-radius: 12px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text {
                        text: "LADON";
                        font-size: 18px;
                        font-weight: 600;
                        color: Palette.text;
                    }
                    Text { text: "版本 0.0.2"; font-size: 12px; color: Palette.muted; }
                    Text {
                        text: "所有数据保存在本地工作区内，不会上传到外部服务。";
                        font-size: 13px;
                        color: Palette.text;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        Rectangle { horizontal-stretch: 1; }
                        Btn {
                            label: "关闭";
                            primary: true;
                            clicked => { root.close-about(); }
                        }
                    }
                }
            }
        }
    }
}
